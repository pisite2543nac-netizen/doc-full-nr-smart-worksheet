rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function active() { return signedIn() && me().data.isActive == true; }
    function admin() { return active() && me().data.role == 'admin'; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function myClassroomId() { return me().data.classroomId; }
    function assignedWorksheet(data) {
      return data.status == 'published' && (
        request.auth.uid in data.targetUserIds ||
        (myClassroomId() != null && myClassroomId() in data.targetClassroomIds)
      );
    }

    match /users/{uid} {
      allow read: if admin() || (active() && self(uid));
      allow create: if false;
      allow update: if active() && self(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL','phone','updatedAt'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.classroomId == resource.data.classroomId;
      allow delete: if false;
    }

    match /classrooms/{id} {
      allow read: if active();
      allow write: if admin();
    }
    match /subjects/{id} {
      allow read: if active();
      allow write: if admin();
    }
    match /worksheets/{id} {
      allow read: if admin() || (active() && assignedWorksheet(resource.data));
      allow write: if false; // writes must go through Cloud Functions
    }
    match /worksheetAnswerKeys/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /submissions/{id} {
      allow read: if admin() || (active() && resource.data.userId == request.auth.uid);
      allow write: if false; // save/submit only via Cloud Functions
    }
    match /submissionGrades/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /submissionOverrides/{id} {
      allow read: if admin() || (active() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    match /auditLogs/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
